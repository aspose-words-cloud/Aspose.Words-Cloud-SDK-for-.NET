properties([
	gitLabConnection('gitlab')
])

parameters {		
		string(name: 'SDK_VERSION', defaultValue: '19.9.0', description: 'version of sdk')
}

def buildCacheImage = "docker.registry.svc.k8s.dynabic.com/words/cloud/sdk/net/release"

node('sdk-linux') {
	try {
			stage('checkout'){
				checkout([$class: 'GitSCM', branches: [[name: '*/master']], doGenerateSubmoduleConfigurations: false, extensions: [[$class: 'LocalBranch', localBranch: "**"]], submoduleCfg: [], userRemoteConfigs: [[credentialsId: '361885ba-9425-4230-950e-0af201d90547', url: 'https://git.auckland.dynabic.com/words-cloud/words-cloud-dotnet.git']]])
			}

			stage('build'){
				withCredentials([usernamePassword(credentialsId: 'k8s-registry', usernameVariable: 'dockerrigistry_login', passwordVariable: 'dockerregistry_password')]) {
					sh 'docker login -u "$dockerrigistry_login" -p "$dockerregistry_password" docker.registry.svc.k8s.dynabic.com'
				}

				sh (script: "docker pull ${buildCacheImage} || true")
				sh (script: "docker build -f scripts/buildRelease.Dockerfile --cache-from=${buildCacheImage} -t ${buildCacheImage} .")
				sh (script: "docker push ${buildCacheImage}")
                
                // create package 
                sh 'mkdir -p $WORKSPACE/package/lib/netstandard2.0 $WORKSPACE/package/License'

                withCredentials([
                    usernamePassword(
                        credentialsId: 'ssl.com',
                        usernameVariable: 'SSL_USERNAME',
                        passwordVariable: 'SSL_PASSWORD'
                    ),
                    string(
                        credentialsId: 'sslSecret',
                        variable: 'SSL_SECRET'
                    ),
                    file(
                        credentialsId: 'snkFile',
                        variable: 'SNK_FILE'
                    ),
                ]) {

                    // Build
                    docker.image(buildCacheImage).inside(
                        '-e HOME=/tmp -e DOTNET_CLI_HOME=/tmp'
                    ) {
                        sh '''
                            set -eu

                            cd /build
                            
                            cp Aspose.Words.Cloud.Sdk/bin/Release/netstandard2.0/aspose_word-for-net.png $WORKSPACE/package/ $WORKSPACE/packages/
                            cp -r License/. $WORKSPACE/package/License/

                            project=Aspose.Words.Cloud.Sdk/Aspose.Words.Cloud.Sdk.csproj

                            dotnet build "$project" \
                                -c Release \
                                --no-restore \
                                -p:SignAssembly=true \
                                -p:AssemblyOriginatorKeyFile="$SNK_FILE" \
                                -v:q

                            cp Aspose.Words.Cloud.Sdk/bin/Release/netstandard2.0/Aspose.Words.Cloud.Sdk.dll $WORKSPACE/package/lib/netstandard2.0
                            cp Aspose.Words.Cloud.Sdk/bin/Release/netstandard2.0/Aspose.Words.Cloud.Sdk.pdb $WORKSPACE/package/lib/netstandard2.0
                            cp Aspose.Words.Cloud.Sdk/bin/Release/netstandard2.0/Aspose.Words.Cloud.Sdk.xml $WORKSPACE/package/lib/netstandard2.0
                        '''
                    }

                    // Sign DLL
                    docker.image('ghcr.io/sslcom/codesigner:latest').inside(
                        '--entrypoint=""'
                    ) {
                        sh '''
                            bash /codesign/CodeSignTool.sh sign \
                                -username="$SSL_USERNAME" \
                                -password="$SSL_PASSWORD" \
                                -totp_secret="$SSL_SECRET" \
                                -input_file_path="$WORKSPACE/package/lib/netstandard2.0/Aspose.Words.Cloud.Sdk.dll" \
                                -override
                        '''
                    }

                    // Verify DLL + pack
                    docker.image(buildCacheImage).inside(
                        '-e HOME=/tmp -e DOTNET_CLI_HOME=/tmp'
                    ) {
                        sh '''
                            set -eu

                            cd /build

                            dll="Aspose.Words.Cloud.Sdk/bin/Release/netstandard2.0/Aspose.Words.Cloud.Sdk.dll"
                            project="Aspose.Words.Cloud.Sdk/Aspose.Words.Cloud.Sdk.csproj"

                            osslsigncode verify -in "$dll"

                            cp "$dll" package/lib/netstandard2.0/
                            cp Aspose.Words.Cloud.Sdk/bin/Release/netstandard2.0/Aspose.Words.Cloud.Sdk.pdb package/lib/netstandard2.0/
                            cp Aspose.Words.Cloud.Sdk/bin/Release/netstandard2.0/Aspose.Words.Cloud.Sdk.xml package/lib/netstandard2.0/
                            cp Aspose.Words.Cloud.Sdk/bin/Release/netstandard2.0/aspose_word-for-net.png package/
                            cp -r License/. package/License/

                            dotnet pack "$project" \
                                -c Release \
                                --no-build \
                                -p:NuspecFile=/build/Aspose.Words.Cloud.Sdk/Aspose.Words-Cloud.nuspec \
                                -p:NuspecBasePath="$WORKSPACE/package" \
                                -p:NuspecProperties="version=$SDK_VERSION" \
                                -o "$WORKSPACE/packages"
                        '''
                    }

                    // Sign NuGet
                    docker.image('ghcr.io/sslcom/codesigner:latest').inside(
                        '--entrypoint=""'
                    ) {
                        sh '''
                            bash /codesign/CodeSignTool.sh sign \
                                -username="$SSL_USERNAME" \
                                -password="$SSL_PASSWORD" \
                                -totp_secret="$SSL_SECRET" \
                                -input_file_path="$WORKSPACE/packages/Aspose.Words-Cloud.$SDK_VERSION.nupkg" \
                                -override
                        '''
                    }

                    // Verify package and copy to Jenkins workspace
                    docker.image(buildCacheImage).inside(
                        '-e HOME=/tmp -e DOTNET_CLI_HOME=/tmp'
                    ) {
                        sh '''
                            set -eu

                            dotnet nuget verify "$WORKSPACE/packages/Aspose.Words-Cloud.$SDK_VERSION.nupkg"
                        '''
                    }
                }
                
				stash name: "package", includes: "packages/*.nupkg"
			}
	} finally {
		deleteDir()
	}
}

stage('wait for publish confirmation'){
	timeout(time:1, unit:'DAYS') {
		input message:'Publish packet?'
	}
}	

node('sdk-linux') {
	try {
			stage('checkout'){
				checkout([$class: 'GitSCM', branches: [[name: '*/master']], doGenerateSubmoduleConfigurations: false, extensions: [[$class: 'LocalBranch', localBranch: "**"]], submoduleCfg: [], userRemoteConfigs: [[credentialsId: '361885ba-9425-4230-950e-0af201d90547', url: 'https://git.auckland.dynabic.com/words-cloud/words-cloud-dotnet.git']]])
			}
		
			stage('publish') {
				unstash "package"
			
				withCredentials([string(credentialsId: 'nugetToken', variable: 'token')]) {
					docker.image('mcr.microsoft.com/dotnet/sdk:9.0').inside('-e HOME=/tmp -e DOTNET_CLI_HOME=/tmp') {
						sh 'dotnet nuget push "packages/Aspose.Words-Cloud.$SDK_VERSION.nupkg" --api-key "$token" --timeout 610 --source https://www.nuget.org/api/v2/package'
					}
				}
			}
		
        stage('Merge master to release'){
            checkout([$class: 'GitSCM', branches: [[name: '*/release']], doGenerateSubmoduleConfigurations: false, extensions: [[$class: 'LocalBranch', localBranch: "**"]], submoduleCfg: [], userRemoteConfigs: [[credentialsId: '361885ba-9425-4230-950e-0af201d90547', url: 'https://git.auckland.dynabic.com/words-cloud/words-cloud-dotnet.git']]])
            sh "git config user.email 'jenkins.aspose@gmail.com'"
            sh "git config user.name 'jenkins'"
            sh "git checkout --merge release"
            sh "git reset --hard origin/release"
            sh "git merge --no-ff --allow-unrelated-histories origin/master"
            sh "git diff --name-status"
            sh 'git commit -am "Merged master branch to release" || true'
            withCredentials([usernamePassword(credentialsId: '361885ba-9425-4230-950e-0af201d90547', passwordVariable: 'gitPass', usernameVariable: 'gitUsername')]) {
                sh 'git push "https://$gitUsername:$gitPass@git.auckland.dynabic.com/words-cloud/words-cloud-dotnet.git" release'
            }
        }
        
        stage('Merge master to testPublishedPackage'){
            checkout([$class: 'GitSCM', branches: [[name: '*/testPublishedPackage']], doGenerateSubmoduleConfigurations: false, extensions: [[$class: 'LocalBranch', localBranch: "**"]], submoduleCfg: [], userRemoteConfigs: [[credentialsId: '361885ba-9425-4230-950e-0af201d90547', url: 'https://git.auckland.dynabic.com/words-cloud/words-cloud-dotnet.git']]])
            sh "git config user.email 'jenkins.aspose@gmail.com'"
            sh "git config user.name 'jenkins'"
            sh "git checkout --merge testPublishedPackage"
            sh "git reset --hard origin/testPublishedPackage"
            sh "git merge --no-ff --allow-unrelated-histories origin/master"
            sh '''sed -i -E '/Include="Aspose.Words-Cloud"/ s/Version="[^"]+"/Version="'"$SDK_VERSION"'"/' Aspose.Words.Cloud.Sdk.Tests/Aspose.Words.Cloud.Sdk.Tests.csproj'''
            sh '''sed -i -E '/Include="Aspose.Words-Cloud"/ s/Version="[^"]+"/Version="'"$SDK_VERSION"'"/' Aspose.Words.Cloud.Sdk.BddTests/Aspose.Words.Cloud.Sdk.BddTests.csproj'''
            sh "git diff --name-status"
            sh 'git commit -am "Merged master branch to testPublishedPackage" || true'
            withCredentials([usernamePassword(credentialsId: '361885ba-9425-4230-950e-0af201d90547', passwordVariable: 'gitPass', usernameVariable: 'gitUsername')]) {
                sh 'git push "https://$gitUsername:$gitPass@git.auckland.dynabic.com/words-cloud/words-cloud-dotnet.git" testPublishedPackage'
            }
        }
        
			stage('add version tag') {			
				sh "git config user.email 'jenkins.aspose@gmail.com'"
				sh "git config user.name 'jenkins'"
				
				sh "git clean -fd"
				sh 'git reset --hard origin/master'
				sh 'git tag -a "$SDK_VERSION" -m "version $SDK_VERSION"'
				
				withCredentials([usernamePassword(credentialsId: '361885ba-9425-4230-950e-0af201d90547', usernameVariable: 'gitUsername', passwordVariable: 'gitPass')]) {
					sh 'git push "https://$gitUsername:$gitPass@git.auckland.dynabic.com/words-cloud/words-cloud-dotnet.git" "$SDK_VERSION"'
				}
			}
	} finally {
		deleteDir()
	}
}